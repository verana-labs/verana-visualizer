{
  "name": "verana-visualizer",
  "version": "1.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check-format": "biome check",
    "fix-format": "biome check --write --unsafe",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test tests/e2e",
    "live": "playwright test tests/live --pass-with-no-tests",
    "perf": "NEXT_PUBLIC_PERF_HARNESS=1 next build && playwright test -c tests/perf/playwright.config.ts",
    "record:fixtures": "tsx scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.1",
    "@tanstack/react-query": "^5.104.5",
    "cmdk": "^1.1.1",
    "next": "16.3.8",
    "next-runtime-env": "^3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "jsdom": "^24.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "glob": "^10.4.5",
      "js-yaml": "^4.1.1"
    },
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "packageManager": "pnpm@9.15.9"
