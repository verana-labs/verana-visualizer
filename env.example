# Legacy names (NEXT_PUBLIC_IDX_ENDPOINT, NEXT_PUBLIC_API_ENDPOINT, NEXT_PUBLIC_RPC_ENDPOINT,
# NEXT_PUBLIC_CHAIN_ID, NEXT_PUBLIC_CHAIN_NAME) are still read as fallbacks.

# Verana indexer base URL, serves every entity, history and stats endpoint
NEXT_PUBLIC_VERANA_INDEXER_BASE_URL=https://idx.testnet.verana.network
# CometBFT RPC endpoint, serves blocks and the chain head
NEXT_PUBLIC_VERANA_RPC_ENDPOINT=https://rpc.testnet.verana.network
# Cosmos REST endpoint, serves bank, mint, staking, gov and distribution
NEXT_PUBLIC_VERANA_REST_ENDPOINT=https://api.testnet.verana.network
# verana-graph URL, serves traces and search (derived from the indexer host when unset)
NEXT_PUBLIC_VERANA_GRAPH_URL=https://graph.testnet.verana.network
# verana-frontend URL used for deep links (derived from the indexer host when unset)
NEXT_PUBLIC_VERANA_FRONTEND_URL=https://app.testnet.verana.network
# Chain id of the network this deployment talks to
NEXT_PUBLIC_VERANA_CHAIN_ID=vna-testnet-1
# Network name shown in the UI (derived from the indexer host when unset)
NEXT_PUBLIC_VERANA_CHAIN_NAME=testnet
# Visualizer of the other network, target of the network switch (derived when unset)
NEXT_PUBLIC_VERANA_PEER_VISUALIZER_URL=https://vis.devnet.verana.network
